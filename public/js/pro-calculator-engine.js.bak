    lcm_calc(s) {
        const a = parseFloat(s.n1) || 0;
        const b = parseFloat(s.n2) || 0;
        const res = CoreMathEngine.lcm(a, b);
        return {
            mainValue: res,
            mainLabel: 'Least Common Multiple',
            subStats: [{ label: 'Product', value: a * b }, { label: 'GCD', value: CoreMathEngine.gcd(a, b) }],
